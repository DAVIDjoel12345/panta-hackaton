# PANTA_API_KEY is server-only. SQLite defaults to backend/data/panta.sqlite.
PORT=3001
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
PANTA_API_KEY=
# Transaction approval stays disabled until Panta verifies the deployment.
# JSON file containing official network, mint, program, IDL and instruction policy.
PANTA_DEPLOYMENT_FILE=
# Server-only HTTPS RPC URL; may contain a provider credential. Never use VITE_*.
SOLANA_RPC_URL=
# Explicit Panta Signal user IDs allowed to inspect provider account metrics.
# Community ownership does not grant this privilege.
PANTA_OPERATOR_USER_IDS=

# External AI only. Never expose these credentials through VITE_ variables.
# Google AI Studio keys belong in GEMINI_API_KEY; OpenRouter keys belong in OPENROUTER_API_KEY.
# Existing OpenRouter keys accidentally saved as GEMINI_API_KEY are detected for compatibility.
GEMINI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Vercel: required hosted database credentials (server only).
# Leave blank only for local development with SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Your public https:// domain. Also add it to FRONTEND_ORIGINS.
APP_PUBLIC_URL=
